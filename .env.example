# Copy to .env. Never commit .env.

# HMAC key for session cookies and signed storage URLs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
KILA_SECRET_KEY=change-me

# Password for the seeded demo users (engineer / reviewer / admin). Only applied on first seed.
KILA_SEED_PASSWORD=kila-demo

# Set true when serving over HTTPS.
KILA_COOKIE_SECURE=false

# Host interface the web UI binds to. Keep 127.0.0.1 unless the LAN must reach it.
KILA_BIND=127.0.0.1

# Offline / no-telemetry switches (also hard-set inside the containers).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
LANGCHAIN_TRACING_V2=false
NEXT_TELEMETRY_DISABLED=1
QDRANT__TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
